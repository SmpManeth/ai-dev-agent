{
  "agent_enabled": true,
  "sandbox_enabled": false,
  "sandbox_image": "ai-dev-agent-sandbox:latest",
  "sandbox_network": "none",
  "require_approval_before_pr": false,
  "max_retries": 3,
  "max_runtime_minutes": 120,
  "max_tokens_per_task": 500000,
  "risk_threshold": "medium",
  "allowed_repositories": [],
  "blocked_file_patterns": [
    ".env",
    ".env.",
    "secrets",
    "credentials",
    "config/database.php",
    "composer.json",
    "package.json",
    "/auth/",
    "authentication",
    "payment",
    "billing",
    "stripe",
    "migration",
    "migrations/",
    "database/migrations",
    ".github/workflows",
    ".gitlab-ci",
    "Jenkinsfile",
    "bitbucket-pipelines",
    "docker-compose",
    "Dockerfile",
    "helm/",
    "k8s/",
    "kubernetes/",
    "terraform/",
    ".circleci",
    "deploy/",
    "deployment/"
  ],
  "blocked_command_patterns": [
    "rm\\s+-rf",
    "rm\\s+-fr",
    "sudo\\s",
    "chmod\\s+777",
    "curl\\s+.*\\|\\s*(?:ba)?sh",
    "wget\\s+.*\\|\\s*(?:ba)?sh",
    "docker\\s+",
    "kubectl\\s+",
    "ssh\\s+.*@",
    "mysql\\s+.*drop\\s+database",
    "psql\\s+.*drop\\s+database",
    "DROP\\s+DATABASE",
    "TRUNCATE\\s+TABLE",
    ">/dev/tcp/",
    "nc\\s+-e",
    "mkfs\\.",
    "dd\\s+if="
  ],
  "allowed_command_prefixes": [
    "git",
    "composer",
    "php",
    "npm",
    "node",
    "python",
    "pytest",
    "phpunit",
    "patch",
    "kill",
    "kill -0",
    "vendor/bin"
  ]
}
