OPENAI_API_KEY=sk-your-key-here
# Production bug-fix default: GPT-5.3 Codex (agentic coding). Requires API access to this model.
OPENAI_MODEL=gpt-5.3-codex
# Optional per-step overrides (unset = use OPENAI_MODEL):
# OPENAI_MODEL_PLANNER=gpt-4o-mini
# OPENAI_MODEL_RESEARCHER=gpt-4o-mini
# OPENAI_MODEL_PATCHER=gpt-5.3-codex

# GitHub (Step 6 — push branch + draft PR)
GITHUB_TOKEN=
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_BASE_BRANCH=main

# Auto clone/pull before agent runs (workspace: ./workspaces/{owner}/{repo})
AI_AGENT_WORKSPACE_ROOT=
AI_AGENT_AUTO_SYNC_REPO=true

# Jira (Step 7 — fetch tickets, comment PR link)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AI
JIRA_LABEL=ai-fix
JIRA_IN_REVIEW_STATUS=In Review
