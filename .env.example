OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# GitHub (Step 6 — push branch + draft PR)
GITHUB_TOKEN=
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_BASE_BRANCH=main

# Auto clone/pull before agent runs (workspace: ./workspaces/{owner}/{repo})
AI_AGENT_WORKSPACE_ROOT=
AI_AGENT_AUTO_SYNC_REPO=true

# Jira (Step 7 — fetch tickets, comment PR link)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AI
JIRA_LABEL=ai-fix
JIRA_IN_REVIEW_STATUS=In Review
